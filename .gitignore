# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/adr/
!/custom_components/
!/docs/
!/scripts/
!/tests/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/pyproject.toml
!/requirements_test.txt
!/zensical.en.toml
!/zensical.ko.toml

# Agent scaffolding (AGENTS.md and its CLAUDE.md / GEMINI.md symlinks,
# .agents/ with skills, workflows, agents and memory, .claude/, .gemini) is
# local-only and deliberately not whitelisted above — it stays on each
# developer's machine, out of the published repo. `.agents/memory/` in
# particular is now backed up nowhere but the working copy.

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store
